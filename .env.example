# Google Gemini API Key (Server-side only - never expose to browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Vapi Voice AI Credentials
VAPI_API_KEY=""
VAPI_PUBLIC_KEY=""
VAPI_ASSISTANT_ID=""
VAPI_WEBHOOK_SECRET=""

# PostgreSQL Database URL (Used by Python FastAPI backend)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voxlead_db"

# JWT Authentication Secret
JWT_SECRET_KEY="replace-with-a-secure-random-secret"

# Frontend & App URLs
FRONTEND_URL="http://localhost:3000"
APP_URL="MY_APP_URL"
